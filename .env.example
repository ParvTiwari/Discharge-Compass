# Free key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
MODEL=openai/gpt-oss-120b
# true = serve cached results only (run each sample once live first to warm data/cache)
DEMO_MODE=false

# Optional: Google Cloud Vision key for reading HANDWRITTEN slips (images are sent to Google only when this is set).
# Without it, photos are read on the device with Tesseract.js (printed text, works offline).
GOOGLE_VISION_API_KEY=
